<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/imgRadarIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_search"
            app:tint="@color/neon_teal" />

        <TextView
            android:id="@+id/txtConnectTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:text="@string/hub_discovered"
            android:textColor="@color/neon_teal"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium" />

        <ProgressBar
            android:id="@+id/progressConnectScanning"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:indeterminateTint="@color/neon_teal" />
    </LinearLayout>

    <TextView
        android:id="@+id/txtConnectStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/scanning_lan"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:scrollbars="none"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Discovered Hosts Dynamic Container -->
            <LinearLayout
                android:id="@+id/containerOnboardingDiscovered"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Official Sandbox Demo Mode Card -->
            <LinearLayout
                android:id="@+id/cardExploreDemo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_demo_card"
                android:padding="16dp"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/txtDemoCardTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/ob_demo_title"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SANDBOX"
                        android:textColor="#C084FC"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_demo_badge"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtDemoCardDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/ob_demo_desc"
                    android:textColor="#C4B5FD"
                    android:textSize="12sp"
                    android:lineSpacingExtra="2dp" />

                <TextView
                    android:id="@+id/txtDemoActionHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/ob_demo_hint"
                    android:textColor="#E9D5FF"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Manual Server Configuration Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOnboardingManualConnect"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="16dp"
                android:text="@string/ob_connect_manual"
                android:textColor="@color/neon_teal"
                android:textSize="12sp"
                app:strokeColor="#3300FFC2"
                app:strokeWidth="1dp"
                app:cornerRadius="10dp"
                app:icon="@android:drawable/ic_menu_preferences"
                app:iconTint="@color/neon_teal"
                app:iconSize="16dp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
