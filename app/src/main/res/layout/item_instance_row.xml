<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutInstanceCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:padding="12dp"
    android:clickable="true"
    android:focusable="true">

    <!-- Vertical Accent Bar on the very left (visible only if active) -->
    <View
        android:id="@+id/viewAccentBar"
        android:layout_width="3dp"
        android:layout_height="0dp"
        android:background="@color/neon_teal"
        android:visibility="gone"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Circle Selection Dot -->
    <ImageView
        android:id="@+id/imgActiveDot"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginStart="6dp"
        android:src="@drawable/bg_status_dot"
        app:tint="@color/neon_teal"
        app:layout_constraintLeft_toRightOf="@id/viewAccentBar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Right Action Buttons Container (aligned right, never overlaps text) -->
    <LinearLayout
        android:id="@+id/layoutRightActions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Switch Button Capsule -->
        <TextView
            android:id="@+id/btnSwitchInstance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:text="SWITCH"
            android:textColor="@color/black"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@color/neon_teal"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone" />

        <!-- Edit Instance pencil button -->
        <ImageView
            android:id="@+id/btnEditInstance"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_frosted_circle"
            android:padding="7dp"
            android:src="@android:drawable/ic_menu_edit"
            app:tint="@color/neon_teal" />

        <!-- Delete Garbage bin button -->
        <ImageView
            android:id="@+id/btnDeleteInstance"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/bg_frosted_circle"
            android:padding="7dp"
            android:src="@android:drawable/ic_menu_delete"
            app:tint="@color/neon_red" />
    </LinearLayout>

    <!-- Instance metadata information container -->
    <LinearLayout
        android:id="@+id/layoutMetaContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="8dp"
        android:orientation="vertical"
        app:layout_constraintLeft_toRightOf="@id/imgActiveDot"
        app:layout_constraintRight_toLeftOf="@id/layoutRightActions"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/txtInstanceName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtInstanceStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textColor="@color/neon_teal"
                android:textSize="8sp"
                android:textStyle="bold"
                android:background="@drawable/bg_pill_cyan"
                android:paddingHorizontal="6dp"
                android:paddingVertical="1.5dp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/txtInstanceLanUrl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/txtInstanceDotWan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="4dp"
                android:text="•"
                android:textColor="#55FFFFFF"
                android:textSize="10sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/txtInstanceWanUrl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#60A5FA"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:ellipsize="end"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
