<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#2D0505"
    android:keepScreenOn="true">

    <!-- Pulsing red overlay background (programmatic animation) -->
    <View
        android:id="@+id/pulse_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#33FF0000"
        android:alpha="0.3" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <!-- Countdown Clock -->
        <TextView
            android:id="@+id/eew_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--"
            android:textSize="100sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:shadowColor="#44FF0000"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="40" />

        <!-- Status label -->
        <TextView
            android:id="@+id/eew_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="S波横波即将到达"
            android:textSize="18sp"
            android:textColor="#CC8888"
            android:fontFamily="monospace"
            android:letterSpacing="0.1"
            android:layout_marginTop="4dp" />

        <!-- Spacer -->
        <View
            android:layout_width="match_parent"
            android:layout_height="24dp" />

        <!-- Info Grid Row 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="12dp"
                android:background="@drawable/eew_info_card_bg"
                android:layout_margin="4dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="震中 EPICENTER"
                    android:textSize="8sp"
                    android:textColor="#886666"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.08" />
                <TextView
                    android:id="@+id/eew_epicenter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textSize="14sp"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="12dp"
                android:background="@drawable/eew_info_card_bg"
                android:layout_margin="4dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="震级 MAGNITUDE"
                    android:textSize="8sp"
                    android:textColor="#886666"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.08" />
                <TextView
                    android:id="@+id/eew_magnitude"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textSize="14sp"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="12dp"
                android:background="@drawable/eew_info_card_bg"
                android:layout_margin="4dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="距离 DISTANCE"
                    android:textSize="8sp"
                    android:textColor="#886666"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.08" />
                <TextView
                    android:id="@+id/eew_distance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textSize="14sp"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="12dp"
                android:background="@drawable/eew_info_card_bg"
                android:layout_margin="4dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="烈度 INTENSITY"
                    android:textSize="8sp"
                    android:textColor="#886666"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.08" />
                <TextView
                    android:id="@+id/eew_intensity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textSize="14sp"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Spacer -->
        <View
            android:layout_width="match_parent"
            android:layout_height="32dp" />

        <!-- Safety Icons Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp"
                android:layout_margin="4dp">
                <TextView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:text="❤️"
                    android:textSize="24sp"
                    android:gravity="center"
                    android:background="@drawable/eew_safety_icon_bg" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="保持冷静"
                    android:textSize="10sp"
                    android:textColor="#4488CC"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp"
                android:layout_margin="4dp">
                <TextView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:text="🛡️"
                    android:textSize="24sp"
                    android:gravity="center"
                    android:background="@drawable/eew_safety_icon_bg" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="躲避桌底"
                    android:textSize="10sp"
                    android:textColor="#DDA044"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp"
                android:layout_margin="4dp">
                <TextView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:text="⚠️"
                    android:textSize="24sp"
                    android:gravity="center"
                    android:background="@drawable/eew_safety_icon_bg" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="远离窗户"
                    android:textSize="10sp"
                    android:textColor="#CC4444"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp"
                android:layout_margin="4dp">
                <TextView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:text="🚫"
                    android:textSize="24sp"
                    android:gravity="center"
                    android:background="@drawable/eew_safety_icon_bg" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="严禁电梯"
                    android:textSize="10sp"
                    android:textColor="#888888"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Spacer -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Slide-to-Dismiss Track -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="滑动解锁解除警报"
            android:textSize="9sp"
            android:textColor="#44FFFFFF"
            android:fontFamily="monospace"
            android:letterSpacing="0.2"
            android:layout_marginBottom="8dp" />

        <FrameLayout
            android:id="@+id/slide_track"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginHorizontal="32dp"
            android:layout_marginBottom="48dp"
            android:background="@drawable/eew_slide_track_bg">

            <!-- Fill -->
            <View
                android:id="@+id/slide_fill"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:background="@drawable/eew_slide_fill_bg" />

            <!-- Handle -->
            <TextView
                android:id="@+id/slide_handle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="4dp"
                android:text="▶"
                android:textSize="20sp"
                android:textColor="#FFFFFF"
                android:gravity="center"
                android:background="@drawable/eew_slide_handle_bg" />

        </FrameLayout>

    </LinearLayout>
</FrameLayout>
